# Database connection string for Prisma (MySQL/MariaDB).
DATABASE_URL="mysql://root:@localhost:3306/wa_blast"

# Port the NestJS server listens on.
PORT=3000

# Secret used to sign JWT tokens. Change this in production!
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Directory where Baileys session credentials are stored (relative to backend/).
WHATSAPP_SESSION_DIR="storage/whatsapp-sessions"

# Directory where campaign attachments are stored (relative to backend/).
MEDIA_UPLOAD_DIR="storage/campaign-media"

# Delay between accounts when auto-restoring persisted sessions after a
# backend restart (milliseconds). Keeps reconnect runs sequential and gentle.
WHATSAPP_RESTORE_DELAY_MS="2000"

# Message queue worker: how many delivery slots across all accounts, and how
# long a PROCESSING message may sit before crash recovery requeues it.
WHATSAPP_WORKER_CONCURRENCY="1"
WHATSAPP_PROCESSING_TIMEOUT_SECONDS="300"
WHATSAPP_MAX_MESSAGE_ATTEMPTS="3"
WHATSAPP_RECOVERY_INTERVAL_SECONDS="60"

# Human-like sending behaviour. Typing shows a "typing..." bubble before each
# message; its duration follows the message length (clamped to min/max).
# Message delay is the pause between two consecutive sends.
# Set WHATSAPP_TYPING_ENABLED to "0" to disable the typing effect, and set both
# delay values to "0" to disable the inter-message pause.
WHATSAPP_TYPING_ENABLED="1"
WHATSAPP_TYPING_MIN_MS="800"
WHATSAPP_TYPING_MAX_MS="5000"
WHATSAPP_TYPING_CHAR_MS="40"
WHATSAPP_MESSAGE_DELAY_MIN_MS="1500"
WHATSAPP_MESSAGE_DELAY_MAX_MS="4000"
