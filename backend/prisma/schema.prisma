generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  status    String   @default("Active")
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Contact {
  id              Int            @id @default(autoincrement())
  idpel           String         @unique
  name            String
  phone           String
  email           String?
  customer_type   String?
  tariff          String?
  power           Int?
  region          String?
  ulp             String?
  last_contact_at DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  groups          ContactGroup[]
  campaignContacts CampaignContact[]
  campaignRecipients CampaignRecipient[]

  @@index([phone])
  @@index([customer_type])
  @@index([tariff])
  @@index([region])
  @@index([ulp])
  @@index([created_at])
  @@map("contacts")
}

model Group {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  slug        String         @unique
  description String?
  color       String?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  contacts    ContactGroup[]
  campaignGroups CampaignGroup[]

  @@map("groups")
}

model ContactGroup {
  id         Int      @id @default(autoincrement())
  contact_id Int
  group_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  contact    Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, group_id])
  @@map("contact_group")
}

model Template {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  category    String
  language    String
  content     String
  variables   String?
  usage_count Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  campaigns   Campaign[]

  @@index([category])
  @@index([language])
  @@index([created_at])
  @@index([updated_at])
  @@map("templates")
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  LOGGED_OUT
}

model WhatsAppAccount {
  id                 String                  @id @default(uuid())
  name               String
  phone              String?
  status             WhatsAppAccountStatus   @default(DISCONNECTED)
  isDefault          Boolean                 @default(false)
  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  messages           WhatsAppMessage[]
  campaigns          Campaign[]

  @@index([status])
  @@index([isDefault])
  @@map("whatsapp_accounts")
}

enum WhatsAppMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model WhatsAppMessage {
  id                  String                @id @default(uuid())
  accountId           String
  recipient           String
  content             String
  status              WhatsAppMessageStatus @default(PENDING)
  attempts            Int                   @default(0)
  maxAttempts         Int                   @default(3)
  lastError           String?
  campaignId          Int?
  /// Baileys message key ID, used to match delivery/read receipts back to
  /// this row.
  waMessageId         String?
  scheduledAt         DateTime              @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  account             WhatsAppAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaign            Campaign?             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignRecipient   CampaignRecipient?

  @@index([status, scheduledAt])
  @@index([accountId, status])
  @@index([status, processingStartedAt])
  @@index([campaignId])
  @@index([accountId, waMessageId])
  @@map("whatsapp_messages")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model Campaign {
  id                      Int                        @id @default(autoincrement())
  name                    String
  description             String?
  status                  CampaignStatus             @default(DRAFT)
  whatsappAccountId       String
  templateId              Int?
  templateContentSnapshot String
  mediaPath      String?
  mediaType      String?
  mediaName      String?
  mediaMimetype String?
  mediaSize      Int?
  scheduledAt             DateTime?
  startedAt               DateTime?
  pausedAt                DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  recipientsCount         Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  whatsappAccount WhatsAppAccount?    @relation(fields: [whatsappAccountId], references: [id], onDelete: Restrict)
  template        Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  targets         CampaignTargets?
  recipients      CampaignRecipient[]
  messages        WhatsAppMessage[]

  @@index([status, scheduledAt])
  @@index([whatsappAccountId])
  @@index([templateId])
  @@map("campaigns")
}

model CampaignTargets {
  id         Int               @id @default(autoincrement())
  campaignId Int               @unique
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contacts   CampaignContact[]
  groups     CampaignGroup[]

  @@map("campaign_targets")
}

model CampaignContact {
  id        Int             @id @default(autoincrement())
  targetsId Int
  contactId Int?
  targets   CampaignTargets @relation(fields: [targetsId], references: [id], onDelete: Cascade)
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([targetsId])
  @@map("campaign_contacts")
}

model CampaignGroup {
  id        Int             @id @default(autoincrement())
  targetsId Int
  groupId   Int?
  groupName String
  targets   CampaignTargets @relation(fields: [targetsId], references: [id], onDelete: Cascade)
  group     Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([targetsId])
  @@map("campaign_groups")
}

model CampaignRecipient {
  id                Int                      @id @default(autoincrement())
  campaignId        Int
  contactId         Int?
  phone             String
  variablesSnapshot String
  status            CampaignRecipientStatus  @default(PENDING)
  messageId         String?                     @unique
  skipReason        String?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  skippedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  message  WhatsAppMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([contactId])
  @@map("campaign_recipients")
}

model WorkspaceSettings {
  id                        Int      @id @default(autoincrement())
  companyName               String   @default("")
  timezone                  String   @default("Asia/Jakarta")
  language                  String   @default("id")
  defaultSenderId           String?
  rateLimitPerMin           Int      @default(60)
  retryLimit                Int      @default(3)
  delayBetweenMs            Int      @default(500)
  notifyCampaignCompleted   Boolean  @default(true)
  notifyCampaignFailed      Boolean  @default(true)
  notifyConnectionError     Boolean  @default(true)
  notifyLowQuota            Boolean  @default(true)
  messageQuota              Int      @default(100000)
  updatedAt                 DateTime @updatedAt

  @@map("workspace_settings")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  user      String
  action    String
  module    String
  date      DateTime @default(now())

  @@index([module])
  @@index([date])
  @@index([user])
  @@map("activity_logs")
}
